# --- MySQL (usuário com permissão mínima criado no schema.sql) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sinapse_app
DB_PASSWORD=sinapse_app_2026
DB_NAME=sinapse

# --- LLM (Google Gemini) ---
# Gere a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=sua-chave-aqui
GEMINI_MODEL=gemini-3.6-flash
# Usados quando o principal atinge o limite gratuito ou fica sobrecarregado
GEMINI_MODELOS_RESERVA=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_TEMPERATURE=0.2

# --- n8n (opcional). Sem URL, o envio é simulado no console ---
N8N_WEBHOOK_LEMBRETE=
N8N_WEBHOOK_OTP=
N8N_WEBHOOK_ATENDENTE=

# Mostra a aba "Auditoria" na interface (só para a apresentação)
DEMO_MODE=1
